APP_NAME="Sala de Leitura CEEBN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8089
APP_TIMEZONE=America/Sao_Paulo

# Identidade visual (personalizável ao compartilhar a aplicação)
BRAND_NAME="Sala de Leitura CEEBN"
BRAND_TAGLINE="Área do Livro Espírita"
BRAND_LOGO=/images/logo.png
BRAND_PRIMARY="#006D5B"
BRAND_PRIMARY_DARK="#005546"
BRAND_SECONDARY="#929497"
BRAND_PAPER="#F5FAF8"
BRAND_INK="#1F2933"

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=saladeleitura
DB_USERNAME=saladeleitura
DB_PASSWORD=saladeleitura
DB_ROOT_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="sala@localhost"
MAIL_FROM_NAME="${APP_NAME}"

INERTIA_SSR_ENABLED=false
APP_PORT=8089
VITE_PORT=5174
MYSQL_PUBLISH_PORT=3308
MAILPIT_UI_PORT=8026
MAILPIT_SMTP_PORT=1026
